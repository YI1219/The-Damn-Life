  "repository": {
    "type": "git",
    "url": "https://github.com/YI1219/The-Damn-Life"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:all": "pnpm exec turbo run dev --parallel",
