{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://damn-life.local/schemas/task-plan-v1.json",
  "title": "TaskPlanV1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "taskType", "summary", "requiresApproval", "riskLevel", "params"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "taskType": { "const": "organize_downloads" },
        "summary": { "type": "string", "minLength": 1 },
        "requiresApproval": { "type": "boolean" },
        "riskLevel": { "type": "string", "enum": ["low", "medium", "high"] },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["targetDir", "allowDelete"],
          "properties": {
            "targetDir": { "type": "string", "minLength": 1 },
            "allowDelete": { "type": "boolean" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "taskType", "summary", "requiresApproval", "riskLevel", "params"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "taskType": { "const": "fetch_page_text" },
        "summary": { "type": "string", "minLength": 1 },
        "requiresApproval": { "type": "boolean" },
        "riskLevel": { "type": "string", "enum": ["low", "medium", "high"] },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "maxChars"],
          "properties": {
            "url": { "type": "string", "minLength": 4 },
            "maxChars": { "type": "integer", "minimum": 256, "maximum": 50000 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "taskType", "summary", "requiresApproval", "riskLevel", "params"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "taskType": { "const": "cli_note_echo" },
        "summary": { "type": "string", "minLength": 1 },
        "requiresApproval": { "type": "boolean" },
        "riskLevel": { "type": "string", "enum": ["low", "medium", "high"] },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["message"],
          "properties": {
            "message": { "type": "string", "minLength": 1, "maxLength": 8000 }
          }
        }
      }
    }
  ]
}
